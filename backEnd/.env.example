# Copiez ce fichier vers .env puis adaptez les valeurs.

# Django
DJANGO_SECRET_KEY=change-me-please-use-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ORIGIN=http://localhost:5173

# MySQL
MYSQL_DATABASE=mikrotik_subscriptions
MYSQL_USER=mikrotik_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=root-change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_SSL=false

# MikroTik RouterOS REST API
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=change-me
MIKROTIK_USE_HTTPS=true
MIKROTIK_TLS_REJECT_UNAUTHORIZED=false
MIKROTIK_TIMEOUT_SECONDS=15

# Ancien backend Node conservé seulement si vous voulez l'utiliser.
PORT=8090
MIKROTIK_TIMEOUT_MS=15000
