# Le frontend lit maintenant ../.env grâce à envDir dans vite.config.ts.
# Copiez ../.env.example vers ../.env à la racine du projet.

VITE_APP_NAME=Subscription MikroTik Management Platform
# Développement: proxy Vite /api -> Django pour éviter CORS.
VITE_USE_VITE_PROXY=true
VITE_API_BASE_URL=http://localhost:8000
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_WITH_CREDENTIALS=false
VITE_FRONTEND_URL=http://localhost:5173,http://localhost:5174
