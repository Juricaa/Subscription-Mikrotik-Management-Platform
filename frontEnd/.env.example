# Copiez ce fichier vers .env puis adaptez les valeurs.

# IP ou nom DNS du routeur MikroTik. Vous pouvez aussi mettre une URL complète.
MIKROTIK_HOST=192.168.88.1

# Compte RouterOS utilisé par le backend.
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=change-me

# REST API RouterOS: recommandé en HTTPS via www-ssl.
MIKROTIK_USE_HTTPS=true

# Si le routeur utilise un certificat auto-signé, mettez false en test.
# En production, utilisez un certificat valide et laissez true.
MIKROTIK_TLS_REJECT_UNAUTHORIZED=false

# Backend local.
PORT=8090
MIKROTIK_TIMEOUT_MS=15000
