# =============================================================
# ENV GLOBAL - FrontEnd React/Vite + BackEnd Django
# Copiez ce fichier vers .env à la racine du projet.
# Le frontend et le backend lisent ce même fichier.
# =============================================================

# Frontend
VITE_APP_NAME=Subscription MikroTik Management Platform
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_FRONTEND_URL=http://localhost:5173

# Django
DJANGO_SECRET_KEY=change-me-please-use-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de données MySQL / MariaDB
MYSQL_DATABASE=mikrotik_subscriptions
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_SSL=false

# MikroTik RouterOS REST API
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=change-me
MIKROTIK_USE_HTTPS=true
MIKROTIK_TLS_REJECT_UNAUTHORIZED=false
MIKROTIK_TIMEOUT_SECONDS=15
