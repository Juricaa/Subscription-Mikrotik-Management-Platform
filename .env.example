# =============================================================
# ENV GLOBAL - FrontEnd React/Vite + BackEnd Django
# Copiez ce fichier vers .env à la racine du projet.
# Le frontend et le backend lisent ce même fichier.
# =============================================================

# Frontend
VITE_APP_NAME=Subscription MikroTik Management Platform
# En développement, on utilise le proxy Vite /api pour bypasser CORS.
# Même si VITE_API_BASE_URL est défini, il sera ignoré tant que VITE_USE_VITE_PROXY=true.
VITE_USE_VITE_PROXY=true
VITE_API_BASE_URL=http://localhost:8000
VITE_PROXY_TARGET=http://127.0.0.1:8000
# Gardez false sauf si vous utilisez une authentification session/cookie Django.
VITE_API_WITH_CREDENTIALS=false
VITE_FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Django
DJANGO_SECRET_KEY=change-me-please-use-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
DJANGO_CORS_ALLOWED_ORIGIN_REGEXES=^http://localhost:[0-9]+$,^http://127\.0\.0\.1:[0-9]+$
DJANGO_CORS_ALLOW_CREDENTIALS=true
DJANGO_CORS_ALLOW_ALL_ORIGINS=false
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Base de données MySQL / MariaDB
MYSQL_DATABASE=mikrotik_subscriptions
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_SSL=false

# MikroTik RouterOS REST API
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=change-me
MIKROTIK_USE_HTTPS=true
MIKROTIK_TLS_REJECT_UNAUTHORIZED=false
MIKROTIK_TIMEOUT_SECONDS=15
